{
  "name": "pocketpilot",
  "displayName": "PocketPilot",
  "description": "Control github-copilot from your phone !",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pocketpilot",
          "title": "PocketPilot",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "pocketpilot": [
        {
          "type": "webview",
          "id": "pocketpilot.dashboard",
          "name": "Dashboard"
        }
      ]
    },
    "commands": [
      {
        "command": "pocketpilot.showQRCode",
        "title": "PocketPilot: Show QR Code"
      },
      {
        "command": "pocketpilot.toggleTunnel",
        "title": "PocketPilot: Toggle Remote Tunnel"
      },
      {
        "command": "pocketpilot.copyAuthToken",
        "title": "PocketPilot: Copy Auth Token"
      },
      {
        "command": "pocketpilot.clearHistory",
        "title": "PocketPilot: Clear Session History"
      }
    ],
    "chatParticipants": [
      {
        "id": "pocketpilot.assistant",
        "name": "pocketpilot",
        "description": "Control Copilot from your phone"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/qrcode": "^1.5.6",
    "@types/vscode": "^1.110.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@github/copilot-sdk": "^0.2.2-preview.0",
    "qrcode": "^1.5.4",
    "ws": "^8.20.0"
  }
}
